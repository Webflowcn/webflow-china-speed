{
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-EdgeOne-Proxy",
          "value": "webflow-china-speedup-edgeone-v2"
        },
        {
          "key": "X-Proxy-Version",
          "value": "webflow-china-speedup/2.4.0"
        }
      ]
    }
  ],
  "caches": [
    {
      "source": "/__eo_asset_v3__/*",
      "cacheTtl": 2592000
    }
  ]
}
